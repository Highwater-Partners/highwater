---
import Base from './Base.astro';
const { frontmatter } = Astro.props;
const { title, dek, date, description } = frontmatter;
const dateFmt = date
  ? new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : '';
---
<Base title={title} description={description ?? dek}>
  <article>
    <div class="essay-head">
      <h1 class="essay-title">{title}</h1>
      {dek && <p class="essay-dek">{dek}</p>}
      <div class="essay-byline">Cole Saseen{dateFmt && ` · ${dateFmt}`}</div>
    </div>
    <hr class="mark" />
    <div class="prose">
      <slot />
    </div>
    <a class="back" href="/">← All writing</a>
  </article>
</Base>
