---
import Base from '../layouts/Base.astro';

// Auto-collects every markdown file in /pages/essays.
const modules = import.meta.glob('./essays/*.md', { eager: true });
const essays = Object.values(modules)
  .map((m) => ({ ...m.frontmatter, url: m.url }))
  .filter((e) => e.draft !== true)
  .sort((a, b) => new Date(b.date) - new Date(a.date));

const fmt = (d) =>
  d ? new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : '';
const total = essays.length;
---
<Base
  title={undefined}
  description="Notes on markets, capital allocation, and concentrated positions — by Cole Saseen."
>
  <p class="lede">
    Notes on markets, capital allocation, and the discipline needed to manage a concentrated portoflio.
  </p>

  <div style="height:2.5rem"></div>

  <ul class="toc">
    {essays.map((e, i) => (
      <li class="toc-item">
        <div class="toc-meta">
          <span class="toc-no">{String(total - i).padStart(2, '0')}</span>
          <span>{fmt(e.date)}</span>
        </div>
        <h2 class="toc-title"><a href={e.url}>{e.title}</a></h2>
        {e.dek && <p class="toc-dek">{e.dek}</p>}
      </li>
    ))}
  </ul>
</Base>
